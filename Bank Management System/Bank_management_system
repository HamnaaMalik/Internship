"""
Bank Management System (CLI)
-----------------------------
A simple console-based Bank Management System built in Python.

Features:
- Create Account
- Deposit Money
- Withdraw Money
- Check Balance
- Transfer Money
- View All Accounts
- View Transaction History
- Delete Account
"""

import json
import os
from datetime import datetime

DATA_FILE = "bank_data.json"


class Bank:
    def __init__(self, data_file=DATA_FILE):
        self.data_file = data_file
        self.accounts = {}
        self.load_data()

    # ---------------- Data Persistence ----------------
    def load_data(self):
        if os.path.exists(self.data_file):
            try:
                with open(self.data_file, "r") as f:
                    self.accounts = json.load(f)
            except (json.JSONDecodeError, IOError):
                self.accounts = {}
        else:
            self.accounts = {}

    def save_data(self):
        with open(self.data_file, "w") as f:
            json.dump(self.accounts, f, indent=4)

    # ---------------- Core Operations ----------------
    def generate_account_number(self):
        if not self.accounts:
            return "1001"
        return str(max(int(acc_no) for acc_no in self.accounts.keys()) + 1)

    def create_account(self, name, cnic, phone, initial_deposit=0.0):
        if initial_deposit < 0:
            print("Initial deposit cannot be negative.")
            return None

        acc_no = self.generate_account_number()
        self.accounts[acc_no] = {
            "name": name,
            "cnic": cnic,
            "phone": phone,
            "balance": round(float(initial_deposit), 2),
            "history": [
                self._make_txn("Account Opened", initial_deposit)
            ],
        }
        self.save_data()
        print(f"\n✅ Account created successfully! Your Account Number is: {acc_no}")
        return acc_no

    def deposit(self, acc_no, amount):
        account = self._get_account(acc_no)
        if not account:
            return False
        if amount <= 0:
            print("Deposit amount must be positive.")
            return False

        account["balance"] = round(account["balance"] + amount, 2)
        account["history"].append(self._make_txn("Deposit", amount))
        self.save_data()
        print(f"✅ Deposited {amount:.2f}. New balance: {account['balance']:.2f}")
        return True

    def withdraw(self, acc_no, amount):
        account = self._get_account(acc_no)
        if not account:
            return False
        if amount <= 0:
            print("Withdrawal amount must be positive.")
            return False
        if amount > account["balance"]:
            print("❌ Insufficient balance.")
            return False

        account["balance"] = round(account["balance"] - amount, 2)
        account["history"].append(self._make_txn("Withdraw", -amount))
        self.save_data()
        print(f"✅ Withdrew {amount:.2f}. New balance: {account['balance']:.2f}")
        return True

    def check_balance(self, acc_no):
        account = self._get_account(acc_no)
        if not account:
            return None
        print(f"💰 Account {acc_no} ({account['name']}) balance: {account['balance']:.2f}")
        return account["balance"]

    def transfer(self, from_acc, to_acc, amount):
        sender = self._get_account(from_acc)
        receiver = self._get_account(to_acc)
        if not sender or not receiver:
            return False
        if amount <= 0:
            print("Transfer amount must be positive.")
            return False
        if amount > sender["balance"]:
            print("❌ Insufficient balance for transfer.")
            return False

        sender["balance"] = round(sender["balance"] - amount, 2)
        receiver["balance"] = round(receiver["balance"] + amount, 2)
        sender["history"].append(self._make_txn(f"Transfer to {to_acc}", -amount))
        receiver["history"].append(self._make_txn(f"Transfer from {from_acc}", amount))
        self.save_data()
        print(f"✅ Transferred {amount:.2f} from {from_acc} to {to_acc}.")
        return True

    def view_all_accounts(self):
        if not self.accounts:
            print("No accounts found.")
            return
        print("\n" + "-" * 60)
        print(f"{'Acc No':<10}{'Name':<20}{'Phone':<15}{'Balance':>10}")
        print("-" * 60)
        for acc_no, info in self.accounts.items():
            print(f"{acc_no:<10}{info['name']:<20}{info['phone']:<15}{info['balance']:>10.2f}")
        print("-" * 60)

    def view_history(self, acc_no):
        account = self._get_account(acc_no)
        if not account:
            return
        print(f"\nTransaction history for {acc_no} ({account['name']}):")
        print("-" * 60)
        for txn in account["history"]:
            print(f"{txn['date']} | {txn['type']:<20} | {txn['amount']:>10.2f}")
        print("-" * 60)

    def delete_account(self, acc_no):
        if acc_no not in self.accounts:
            print("❌ Account not found.")
            return False
        confirm = input(f"Are you sure you want to delete account {acc_no}? (y/n): ").strip().lower()
        if confirm == "y":
            del self.accounts[acc_no]
            self.save_data()
            print("✅ Account deleted.")
            return True
        print("Cancelled.")
        return False

    # ---------------- Helpers ----------------
    def _get_account(self, acc_no):
        account = self.accounts.get(str(acc_no))
        if not account:
            print(f"❌ Account {acc_no} not found.")
        return account

    @staticmethod
    def _make_txn(txn_type, amount):
        return {
            "date": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "type": txn_type,
            "amount": round(float(amount), 2),
        }


# ---------------- Input Helpers ----------------
def get_float(prompt):
    while True:
        try:
            return float(input(prompt))
        except ValueError:
            print("Please enter a valid number.")


def get_nonempty(prompt):
    while True:
        value = input(prompt).strip()
        if value:
            return value
        print("This field cannot be empty.")


# ---------------- Main Menu ----------------
def main():
    bank = Bank()

    menu = """
==========================================
        BANK MANAGEMENT SYSTEM
==========================================
1. Create Account
2. Deposit Money
3. Withdraw Money
4. Check Balance
5. Transfer Money
6. View All Accounts
7. View Transaction History
8. Delete Account
9. Exit
==========================================
"""

    while True:
        print(menu)
        choice = input("Enter your choice (1-9): ").strip()

        if choice == "1":
            name = get_nonempty("Enter full name: ")
            cnic = get_nonempty("Enter CNIC number: ")
            phone = get_nonempty("Enter phone number: ")
            deposit = get_float("Enter initial deposit amount: ")
            bank.create_account(name, cnic, phone, deposit)

        elif choice == "2":
            acc_no = get_nonempty("Enter account number: ")
            amount = get_float("Enter amount to deposit: ")
            bank.deposit(acc_no, amount)

        elif choice == "3":
            acc_no = get_nonempty("Enter account number: ")
            amount = get_float("Enter amount to withdraw: ")
            bank.withdraw(acc_no, amount)

        elif choice == "4":
            acc_no = get_nonempty("Enter account number: ")
            bank.check_balance(acc_no)

        elif choice == "5":
            from_acc = get_nonempty("Enter sender account number: ")
            to_acc = get_nonempty("Enter receiver account number: ")
            amount = get_float("Enter amount to transfer: ")
            bank.transfer(from_acc, to_acc, amount)

        elif choice == "6":
            bank.view_all_accounts()

        elif choice == "7":
            acc_no = get_nonempty("Enter account number: ")
            bank.view_history(acc_no)

        elif choice == "8":
            acc_no = get_nonempty("Enter account number: ")
            bank.delete_account(acc_no)

        elif choice == "9":
            print("Thank you for using the Bank Management System. Goodbye!")
            break

        else:
            print("❌ Invalid choice. Please select a number between 1 and 9.")


if __name__ == "__main__":
    main()
